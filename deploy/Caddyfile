app.pocketpm.fyi {
    # Was: root * /var/www/pocketpm + file_server (the single-file prototype).
    # The prototype remains on disk at /var/www/pocketpm as the rollback target.
    reverse_proxy 127.0.0.1:3001
    encode gzip
}

pb.pocketpm.fyi {
    reverse_proxy 127.0.0.1:8090
}

api.pocketpm.fyi {
    @options {
        method OPTIONS
    }
    respond @options 204

    reverse_proxy 127.0.0.1:3000

    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-PB-Token"
        Access-Control-Max-Age 86400
        defer
    }
}
