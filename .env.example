# Express API proxy — auth, CRUD, and Claude AI all go through this.
# The Anthropic key lives only on that server; it is never present here.
NEXT_PUBLIC_API_URL=https://api.pocketpm.fyi

# PocketBase — scaffolded per the required lib/pocketbase.ts, not yet wired
# into any data flow (all data operations currently go through the Express
# proxy above). Kept here so it's ready if/when that changes.
NEXT_PUBLIC_PB_URL=https://pb.pocketpm.fyi
