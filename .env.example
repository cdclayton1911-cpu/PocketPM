# ═══════════════════════════════════════════════════════════════════════════
# Pocket PM — environment configuration
#
# Local:      copy to .env.local  (git-ignored)
# Production: copy to /etc/pocketpm-web.env on the droplet, then
#               sudo chown root:root /etc/pocketpm-web.env
#               sudo chmod 600      /etc/pocketpm-web.env
#             It is read by the systemd unit via EnvironmentFile=.
#
# NO SECRETS BELONG IN THIS FILE — it is tracked in git. Fill real values in
# .env.local (git-ignored) locally, or in /etc/pocketpm-web.env on the droplet.
#
# systemd EnvironmentFile syntax note: values are literal. Do not quote them,
# do not add trailing comments on a value line, and do not use shell
# expansion — `FOO=$BAR` is passed through as the literal string `$BAR`.
# ═══════════════════════════════════════════════════════════════════════════


# ── Backend endpoints ────────────────────────────────────────────────────────

# Express proxy. Every data operation goes through it — auth, CRUD, and AI.
NEXT_PUBLIC_API_URL=https://api.pocketpm.fyi

# PocketBase. Currently unused by the app: lib/pocketbase.ts is scaffolded but
# unwired, because all data flows through the Express proxy above. Kept so the
# client is ready if direct access (e.g. realtime subscriptions) is added.
NEXT_PUBLIC_PB_URL=https://pb.pocketpm.fyi


# ── AI (Anthropic) ────────────────────────────────────────────────────────────

# Read by src/lib/ai/anthropic.ts, server-side only. It has no NEXT_PUBLIC_
# prefix, so Next.js will not inline it into any client bundle — do not add one.
#
# LEAVE EMPTY HERE. A real key in this file would be committed. Set it in
# .env.local / /etc/pocketpm-web.env.
#
# Without it, POST /api/ai/<task> returns 503 with "AI is not configured on
# this server". Everything else in the app works; only the AI modules are down.
#
# This replaces the key held by the Express service at api.pocketpm.fyi, whose
# POST /api/claude had no auth and no rate limit. Revoke that key once the
# Next.js app is serving.
ANTHROPIC_API_KEY=

# Required ONLY if the key above is identity-linked (created against a user
# rather than a workspace). Such keys reject every request with a 400 naming
# this header until the workspace is given. A plain workspace key needs no
# value here — leave it blank.
#
# Not a secret: it identifies a workspace, it does not authenticate. It lives
# here because it is part of this client's configuration.
ANTHROPIC_WORKSPACE_ID=

# Per-user AI requests per rolling hour (src/lib/rate-limit.ts). Defaults to 20.
# Counted per PocketBase user id, in this process's memory — see the limitation
# note in that file before running more than one instance.
AI_RATE_LIMIT_PER_HOUR=20


# ── Runtime ──────────────────────────────────────────────────────────────────

# Set to `production` on the droplet. Next.js sets this itself during
# `next build`/`next start`, so it is mostly belt-and-braces, but some
# dependencies branch on it.
NODE_ENV=production

# Opt out of Next.js anonymous telemetry. Optional; drop the line to leave it on.
NEXT_TELEMETRY_DISABLED=1


# ── Not set here, deliberately ───────────────────────────────────────────────
#
# PORT and HOSTNAME are NOT set in this file. The bind address is passed as
# explicit flags in deploy/pocketpm-web.service:
#
#     ExecStart=/usr/bin/npm start -- --hostname 127.0.0.1 --port 3001
#
# One source of truth, and it keeps the app bound to loopback so Caddy stays
# the only public entry point. If you set PORT here as well, the two can drift
# and you will get a confusing 502 from Caddy.
